# Required — Supabase (client + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for API routes (inquiry, feedback, analytics, auth funnel).
# Without this key, server-side writes fail gracefully (500 or silent skip).
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL for auth email links.
# Must match your Supabase redirect allow list and Site URL.
# Local: http://localhost:3000
# Production: https://www.thegreyproject.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
